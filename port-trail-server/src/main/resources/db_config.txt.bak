# 数据库连接信息模板。复制为同目录的 db_config.txt 后填入真实值（db_config.txt 已被 .gitignore 忽略）。
# 由 application.yml 的 spring.config.import 以 properties 格式引入
spring.datasource.url=jdbc:mysql://xx.xxx.xx.xxx:xxxxx/port-trail?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&characterSetResults=UTF-8&preserveInstants=true&connectionTimeZone=GMT%2B8&forceConnectionTimeZoneToSession=true&rewriteBatchedStatements=true&nullCatalogMeansCurrent=true
spring.datasource.username=xxx
spring.datasource.password=xxx
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.hikari.pool-name=HikariCP
spring.datasource.hikari.auto-commit=false
spring.datasource.hikari.transaction-isolation=2
# 最小空闲连接数
spring.datasource.hikari.minimum-idle=1
# 连接池最大连接数
spring.datasource.hikari.maximum-pool-size=3
# 空闲连接存活最大时间(ms)，配置为10分钟
spring.datasource.hikari.idle-timeout=600000
# 此属性控制池中连接的最长生命周期(ms)，配置为30分钟
spring.datasource.hikari.max-lifetime=1800000
# 数据库连接超时时间(ms)，配置为3秒
spring.datasource.hikari.connection-timeout=3000
# 连接测试 query
spring.datasource.hikari.connection-test-query=select 1
